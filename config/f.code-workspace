  "settings": {
    // turn off typecheck and linting for rapid dev
    // so damn frustrating and noisy, err when i have not finished typing
    // "eslint.enable": false,
    // "typescript.validate.enable": false,

    "files.exclude": {
      // // Legacy
      // "**/legacy/**": true,
      // Aliases
      "**/AGENTS.md": true,
      // Deps
      "**/node_modules/**": true,
      // Build
      "**/pnpm-lock.yaml": true,
      "**/bun.lock": true,
      "**/build/**": true,
      "**/.build/**": true,
      "**/.vite/**": true,
      "**/.parcel/**": true,
      "**/.parcel-cache/**": true,
      // Static
      "**/.npmrc": true
      // "**/.vscode/**": true, // no vendor lock in
      // "**/.git/**": true, // ignored by default
    },
    "search.exclude": {
      "**/legacy/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.build/**": true
      // "**/.vscode/**": true, // no vendor lock in
      // "**/.git/**": true, // ignored by default
    },
    // remove some folders from intellisense (e.g. css var auto complete)
    // apply: restart or run command: reload window
    "files.watcherExclude": {
      "**/legacy/**": true,
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.build/**": true
    },
    "files.associations": {
      "*.json": "jsonc"
    }
  }
}
